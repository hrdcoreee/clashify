#!/bin/sh
set -e

echo "[*] Stopping Clashify daemon and processes..."
/usr/local/bin/mihomo-ctl stop 2>/dev/null || true
killall -9 mihomo 2>/dev/null || true
killall -9 Mihomo 2>/dev/null || true

if [ -f /Library/LaunchDaemons/com.hrdcoreee.clashify.plist ]; then
    launchctl unload /Library/LaunchDaemons/com.hrdcoreee.clashify.plist 2>/dev/null || true
fi

exit 0
