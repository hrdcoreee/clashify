<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hrdcoreee.clashify</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/mihomo</string>
        <string>-d</string>
        <string>/var/mobile/Library/Mihomo</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>WorkingDirectory</key>
    <string>/var/mobile/Library/Mihomo</string>
    <key>StandardOutPath</key>
    <string>/var/mobile/Library/Mihomo/mihomo.log</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Library/Mihomo/mihomo.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/var/mobile</string>
        <key>PATH</key>
        <string>/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin</string>
    </dict>
</dict>
</plist>
